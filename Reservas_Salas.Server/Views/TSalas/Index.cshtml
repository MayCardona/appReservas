@model IEnumerable<Reservas_Salas.Server.Models.TSala>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Salas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reservado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Salas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Reservado)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdSala">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdSala">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdSala">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
