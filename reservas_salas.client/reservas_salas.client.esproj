<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.2752196">
 
  <PropertyGroup>
<!-- Comando para ejecutar el servidor de desarrollo -->
<StartupCommand>npm run dev</StartupCommand>
 
    <!-- Comando que corre al compilar (produce la carpeta dist) -->
<BuildCommand>npm run build</BuildCommand>
 
    <!-- Donde se guarda el resultado del build -->
<BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
 
    <!-- Ruta raíz del proyecto JS -->
<JavaScriptProjectRoot>$(MSBuildProjectDirectory)</JavaScriptProjectRoot>
 
    <!-- Permite compilar automáticamente al publicar -->
<ShouldRunBuildScript>true</ShouldRunBuildScript>
</PropertyGroup>
 
</Project>